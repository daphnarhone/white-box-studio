# ── White Box Studio — repo ignore rules ──────────────────────────────
# Edit-time backup snapshots (e.g. index.html.bak-20260608-111242)
*.bak
*.bak-*

# Local backup folders and deploy bundles (never commit these)
*BACKUP*/
*.zip

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp

# Node (only if _tools/ ever pulls dependencies)
node_modules/

# Logs / temp
*.log

# Pomelli source material — brand-book PDF revisions and generated creative
# images. Kept locally as reference; large binaries with no build role, and the
# PDFs supersede each other by revision rather than being worth versioning.
pomelli/
docs/*pomelli*.pdf
